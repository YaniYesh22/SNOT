def lambda_handler(event: Dict[str, Any], context: Any) -> Dict[str, Any]:
    """
    Rate-limited chat handler with enhanced prompt and source handling
    """
    try:
        # Parse request
        if 'body' in event:
            body = json.loads(event['body']) if isinstance(event['body'], str) else event['body']
        else:
            body = event
        
        # Check if this is a save chat request
        if body.get('action') == 'save_chat':
            return save_chat_history(body)
        
        # Regular chat request
        email = body.get('email')
        notebook_uuid = body.get('notebook_uuid')
        question = body.get('question', '').strip()
        conversation_history = body.get('conversation_history', [])
        
        if not all([email, notebook_uuid, question]):
            return create_api_response(400, {
                'error': 'Missing required parameters',
                'required': ['email', 'notebook_uuid', 'question']
            })
        
        # Check rate limits BEFORE processing
        rate_limit_check = check_user_rate_limit(email, notebook_uuid)
        if not rate_limit_check['allowed']:
            return create_api_response(429, {
                'error': 'Rate limit exceeded',
                'message': f"Please wait {rate_limit_check['wait_time']} seconds before sending another message.",
                'retry_after': rate_limit_check['wait_time'],
                'rate_limit': rate_limit_check
            })
        
        # Record this request
        record_request(email, notebook_uuid)
        
        logger.info(f"Processing chat request for {email}, notebook {notebook_uuid}")
        
        # Load vector database
        vector_db = load_vector_db('smart-notebook-media', email, notebook_uuid)
        if not vector_db or not vector_db.get('chunks'):
            return create_api_response(400, {
                'answer': 'No vector database found. Please process your notebook files first.',
                'error': 'no_vector_db'
            })
        
        # Search for relevant chunks
        relevant_chunks = search_relevant_chunks(vector_db, question)
        
        if not relevant_chunks:
            return create_api_response(200, {
                'answer': "I couldn't find relevant information in your notebook to answer this question. Could you try rephrasing your question or asking about a different topic covered in your materials?",
                'question': question,
                'chunks_found': 0
            })
        
        # Generate response with enhanced rate limiting
        try:
            answer = generate_chat_response_with_enhanced_retry(
                question=question,
                context=build_context_from_chunks(relevant_chunks),
                conversation_history=conversation_history,
                user_id=f"{email}_{notebook_uuid}",
                relevant_chunks=relevant_chunks  # Pass chunks for better context
            )
        except RateLimitException as e:
            return create_api_response(429, {
                'error': 'Bedrock rate limit',
                'message': 'The AI service is currently busy. Please wait a moment and try again.',
                'retry_after': 10,
                'suggestion': 'Try again in 10-15 seconds'
            })
        
        # Build enhanced source information
        sources = build_enhanced_source_information(relevant_chunks)
        
        return create_api_response(200, {
            'answer': answer,
            'question': question,
            'notebook_uuid': notebook_uuid,
            'sources': sources,
            'chunks_found': len(relevant_chunks),
            'rate_limit_status': get_rate_limit_status(email, notebook_uuid)
        })
        
    except Exception as e:
        logger.error(f"Chat error: {str(e)}")
        return create_api_response(500, {'error': str(e)})

def save_chat_history(body: Dict[str, Any]) -> Dict[str, Any]:
    """
    Save chat history to S3
    """
    try:
        email = body.get('email')
        notebook_uuid = body.get('notebook_uuid')
        chat_history = body.get('chat_history', [])
        chat_title = body.get('chat_title', '')
        
        if not all([email, notebook_uuid, chat_history]):
            return create_api_response(400, {
                'error': 'Missing required parameters',
                'required': ['email', 'notebook_uuid', 'chat_history']
            })
        
        # Generate chat ID and timestamp
        chat_id = str(uuid.uuid4())
        timestamp = datetime.now().isoformat()
        
        # Auto-generate title if not provided
        if not chat_title:
            chat_title = "Untitled Chat"
            # Try to use first user message as title
            for msg in chat_history:
                if msg.get('role') == 'user' and msg.get('content'):
                    chat_title = msg['content'][:50].strip()
                    if len(msg['content']) > 50:
                        chat_title += "..."
                    break
        
        # Create chat data
        chat_data = {
            'chat_id': chat_id,
            'notebook_uuid': notebook_uuid,
            'email': email,
            'title': chat_title,
            'timestamp': timestamp,
            'message_count': len(chat_history),
            'chat_history': chat_history
        }
        
        # Save to S3
        bucket = 'smart-notebook-media'
        key = f"notebooks/{email}/{notebook_uuid}/chats/{chat_id}.json"
        
        s3_client.put_object(
            Bucket=bucket,
            Key=key,
            Body=json.dumps(chat_data, default=str, indent=2),
            ContentType='application/json'
        )
        
        logger.info(f"Chat saved: {chat_id} for {email}/{notebook_uuid}")
        
        return create_api_response(200, {
            'message': 'Chat saved successfully',
            'chat_id': chat_id,
            'title': chat_title,
            'timestamp': timestamp
        })
        
    except Exception as e:
        logger.error(f"Error saving chat: {str(e)}")
        return create_api_response(500, {
            'error': 'Failed to save chat',
            'details': str(e)
        })

def generate_chat_response_with_enhanced_retry(
    question: str, 
    context: str, 
    conversation_history: List[Dict], 
    user_id: str,
    relevant_chunks: List[Dict],
    max_retries: int = 2
) -> str:
    """
    Enhanced retry logic with improved prompt
    """
    base_delay = 5
    max_delay = 30
    
    for attempt in range(max_retries + 1):
        try:
            # Build conversation messages
            messages = []
            for msg in conversation_history[-6:]:  # Keep last 6 messages for context
                if msg.get('role') in ['user', 'assistant'] and msg.get('content'):
                    messages.append({
                        "role": msg['role'],
                        "content": [{"text": msg['content']}]
                    })
            
            messages.append({
                "role": "user",
                "content": [{"text": question}]
            })
            
            # Enhanced system message with better instructions
            system_message = build_enhanced_system_prompt(context, relevant_chunks)
            
            # Call Bedrock Converse API
            logger.info(f"Bedrock attempt {attempt + 1}/{max_retries + 1} for user {user_id}")
            
            response = bedrock_client.converse(
                modelId="anthropic.claude-3-haiku-20240307-v1:0",
                messages=messages,
                system=[{"text": system_message}],
                inferenceConfig={
                    "maxTokens": 2500,  # Increased for more detailed responses
                    "temperature": 0.4,  # Slightly more creative
                    "topP": 0.9
                }
            )
            
            answer = response['output']['message']['content'][0]['text']
            logger.info(f"Bedrock call successful on attempt {attempt + 1}")
            return answer.strip()
            
        except Exception as e:
            error_str = str(e)
            
            if 'ThrottlingException' in error_str or 'Too many requests' in error_str:
                if attempt < max_retries:
                    delay = min(base_delay * (2 ** attempt), max_delay)
                    jitter = delay * 0.1 * (0.5 - hash(user_id) % 100 / 100)
                    total_delay = delay + jitter
                    
                    logger.warning(f"Bedrock throttling for {user_id}. Retrying in {total_delay:.1f}s")
                    time.sleep(total_delay)
                    continue
                else:
                    logger.error(f"Max retries exceeded for {user_id}")
                    raise RateLimitException("Bedrock rate limit exceeded")
            
            elif 'ValidationException' in error_str:
                return "I had trouble understanding your question format. Could you please rephrase it?"
            elif 'ModelNotReadyException' in error_str:
                return "I'm still warming up. Please try again in just a moment."
            else:
                logger.error(f"Bedrock error: {error_str}")
                return f"I encountered an unexpected error. Please try asking your question again."
    
    raise RateLimitException("Unable to generate response after retries")

