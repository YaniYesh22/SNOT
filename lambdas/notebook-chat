        source_type = get_source_type(metadata)
        display_name = get_display_name(metadata)
        source_info.append(f"- {display_name} ({source_type})")
    
    sources_list = "\n".join(source_info) if source_info else "- Various notebook materials"
    
    return f"""You are an intelligent study assistant helping a student understand their notebook materials. You have access to content from their personal learning resources and should provide helpful, accurate, and contextual responses.

**Your Role & Personality:**
- Act as a knowledgeable tutor who is patient, encouraging, and thorough
- Explain concepts clearly and adapt your explanations to the student's apparent level
- Connect ideas across different sources when relevant
- Ask clarifying questions when the student's question is ambiguous
- Encourage deeper thinking with follow-up questions when appropriate

**Available Sources:**
{sources_list}

**Content to Reference:**
{context}

**Instructions for Your Response:**
1. **Answer Comprehensively**: Provide complete, well-structured answers that fully address the question
2. **Use Natural Language**: Write conversationally, as if speaking to a student in person
3. **Reference Sources Thoughtfully**: When you mention information from sources, reference them naturally (e.g., "According to your video on X..." or "In the document about Y...")
4. **Provide Examples**: Use concrete examples from the materials when possible
5. **Connect Concepts**: Link related ideas across different sources in your notebook
6. **Encourage Learning**: End with a thought-provoking question or suggestion for further exploration when appropriate
7. **Be Honest About Limitations**: If the provided materials don't contain enough information to fully answer a question, say so and suggest what additional information might be helpful

**Response Style:**
- Use clear paragraphs and logical flow
- Include relevant details but avoid overwhelming the student
- Use formatting (like bullet points or numbered lists) when it helps clarity
- Maintain an encouraging and supportive tone
- Keep responses focused but comprehensive

Remember: You're helping this student learn and understand their own materials better. Be their ideal study partner."""

def get_source_type(metadata: Dict) -> str:
    """
    Determine the type of source based on metadata
    """
    filename = metadata.get('filename', '').lower()
    original_name = metadata.get('original_name', '').lower()
    source_type = metadata.get('source_type', '').lower()
    
    # Check explicit source type first
    if source_type:
        if 'youtube' in source_type:
            return 'YouTube Video'
        elif 'pdf' in source_type:
            return 'PDF Document'
        elif 'audio' in source_type:
            return 'Audio Recording'
        elif 'image' in source_type:
            return 'Image/Screenshot'
        elif 'note' in source_type:
            return 'Text Note'
    
    # Infer from filename/extension
    if any(ext in filename for ext in ['.mp4', '.avi', '.mov', '.mkv']):
        return 'Video'
    elif any(ext in filename for ext in ['.pdf']):
        return 'PDF Document'
    elif any(ext in filename for ext in ['.mp3', '.wav', '.m4a', '.aac']):
        return 'Audio Recording'
    elif any(ext in filename for ext in ['.jpg', '.jpeg', '.png', '.gif', '.bmp']):
        return 'Image'
    elif any(ext in filename for ext in ['.txt', '.md', '.doc', '.docx']):
        return 'Text Document'
    elif any(ext in filename for ext in ['.json']):
        return 'Data File'
    elif 'youtube' in filename or 'yt_' in filename:
        return 'YouTube Video'
    else:
        return 'Document'

def get_display_name(metadata: Dict) -> str:
    """
    Get the proper display name for a source, avoiding AWS S3 paths
    """
    # Priority order for getting the display name
    original_name = metadata.get('original_name', '')
    title = metadata.get('title', '')
    video_title = metadata.get('video_title', '')
    filename = metadata.get('filename', '')
    
    # For YouTube videos, prefer video title
    if video_title and ('youtube' in metadata.get('source_type', '').lower() or 'yt_' in filename):
        return video_title
    
    # For other content, prefer original name or title
    if original_name and not original_name.startswith('notebooks/'):
        return original_name
    
    if title and not title.startswith('notebooks/'):
        return title
    
    # Clean up filename if that's all we have
    if filename:
        # Remove S3 path prefixes
        clean_name = filename.split('/')[-1]  # Get just the filename
        
        # Remove common processing suffixes
        clean_name = clean_name.replace('_processed', '').replace('_chunk_', '_')
        
        # Remove file extensions for display
        if '.' in clean_name:
            clean_name = '.'.join(clean_name.split('.')[:-1])
        
        return clean_name
    
    return 'Untitled Document'

def build_enhanced_source_information(chunks: List[Dict]) -> List[Dict]:
    """
    Build enhanced source information with proper display names
    """
    sources = []
    seen_sources = set()  # Avoid duplicate sources
    
    for i, chunk in enumerate(chunks[:5]):  # Show up to 5 sources
        metadata = chunk.get('metadata', {})
        display_name = get_display_name(metadata)
        source_type = get_source_type(metadata)
        
        # Create a unique identifier to avoid duplicates
        source_id = f"{display_name}_{source_type}"
        if source_id in seen_sources:
            continue
        
        seen_sources.add(source_id)
        
        source_info = {
            'source_number': len(sources) + 1,
            'name': display_name,
            'type': source_type,
            'similarity_score': chunk.get('similarity_score', 0),
            'preview': chunk['text'][:200].strip() + "..." if len(chunk['text']) > 200 else chunk['text'].strip()
        }
        
        # Add additional metadata if available
        if metadata.get('page_number'):
            source_info['page'] = metadata['page_number']
        if metadata.get('timestamp'):
            source_info['timestamp'] = metadata['timestamp']
        if metadata.get('duration'):
            source_info['duration'] = metadata['duration']
        
        sources.append(source_info)
    
    return sources

def build_context_from_chunks(chunks: List[Dict]) -> str:
    """
    Build enhanced context from chunks with better formatting
    """
    if not chunks:
        return "No relevant content found."
    
    context_parts = []
    for i, chunk in enumerate(chunks[:4]):  # Use top 4 chunks
        metadata = chunk.get('metadata', {})
        display_name = get_display_name(metadata)
        source_type = get_source_type(metadata)
        
        # Add source header
        header = f"--- Source {i+1}: {display_name} ({source_type}) ---"
        
        # Add location information if available
        location_info = []
        if metadata.get('page_number'):
            location_info.append(f"Page {metadata['page_number']}")
        if metadata.get('timestamp'):
            location_info.append(f"Time: {metadata['timestamp']}")
        
        if location_info:
            header += f" [{', '.join(location_info)}]"
        
        # Clean and format the text
        text = chunk['text'].strip()
        
        context_parts.append(f"{header}\n{text}")
    
    return '\n\n'.join(context_parts)

def check_user_rate_limit(email: str, notebook_uuid: str) -> Dict:
    """Check if user has exceeded rate limits"""
    user_key = f"{email}_{notebook_uuid}"
    current_time = datetime.now()
    
    try:
        if not rate_limit_table:
            logger.warning("Rate limit table not available, allowing request")
            return {'allowed': True}
            
        response = rate_limit_table.get_item(Key={'user_id': user_key})
        user_data = response.get('Item', {})
        
        last_request_time = user_data.get('last_request_time')
        requests_this_minute = user_data.get('requests_this_minute', 0)
        requests_this_hour = user_data.get('requests_this_hour', 0)
        minute_window = user_data.get('minute_window')
        hour_window = user_data.get('hour_window')
        
        if last_request_time:
            last_request_time = datetime.fromisoformat(last_request_time)
        if minute_window:
            minute_window = datetime.fromisoformat(minute_window)
        if hour_window:
            hour_window = datetime.fromisoformat(hour_window)
        
        if last_request_time and (current_time - last_request_time).total_seconds() < 3:
            wait_time = 3 - (current_time - last_request_time).total_seconds()
            return {
                'allowed': False,
                'reason': 'Too frequent requests',
                'wait_time': int(wait_time) + 1
            }
        
        if not minute_window or (current_time - minute_window).total_seconds() >= 60:
            requests_this_minute = 0
            minute_window = current_time
        
        if not hour_window or (current_time - hour_window).total_seconds() >= 3600:
            requests_this_hour = 0
            hour_window = current_time
        
        if requests_this_minute >= 10:
            return {
                'allowed': False,
                'reason': 'Minute limit exceeded',
                'wait_time': 60 - int((current_time - minute_window).total_seconds())
            }
        
        if requests_this_hour >= 50:
            return {
                'allowed': False,
                'reason': 'Hour limit exceeded',
                'wait_time': 3600 - int((current_time - hour_window).total_seconds())
            }
        
        return {'allowed': True}
        
    except Exception as e:
        logger.warning(f"Rate limit check error (allowing request): {e}")
        return {'allowed': True}

def record_request(email: str, notebook_uuid: str):
    """Record a request for rate limiting"""
    user_key = f"{email}_{notebook_uuid}"
    current_time = datetime.now()
    
    try:
        if not rate_limit_table:
            logger.warning("Rate limit table not available, skipping request recording")
            return
            
        response = rate_limit_table.get_item(Key={'user_id': user_key})
        user_data = response.get('Item', {})
        
        minute_window = user_data.get('minute_window')
        hour_window = user_data.get('hour_window')
        
        if minute_window:
            minute_window = datetime.fromisoformat(minute_window)
        if hour_window:
            hour_window = datetime.fromisoformat(hour_window)
        
        requests_this_minute = user_data.get('requests_this_minute', 0)
        requests_this_hour = user_data.get('requests_this_hour', 0)
        
        if not minute_window or (current_time - minute_window).total_seconds() >= 60:
            requests_this_minute = 0
            minute_window = current_time
        
        if not hour_window or (current_time - hour_window).total_seconds() >= 3600:
            requests_this_hour = 0
            hour_window = current_time
        
        requests_this_minute += 1
        requests_this_hour += 1
        
        rate_limit_table.put_item(Item={
            'user_id': user_key,
            'last_request_time': current_time.isoformat(),
            'requests_this_minute': requests_this_minute,
            'requests_this_hour': requests_this_hour,
            'minute_window': minute_window.isoformat(),
            'hour_window': hour_window.isoformat(),
            'ttl': int((current_time + timedelta(days=1)).timestamp())
        })
    except Exception as e:
        logger.warning(f"Failed to record request (continuing anyway): {e}")

def get_rate_limit_status(email: str, notebook_uuid: str) -> Dict:
    """Get current rate limit status for user"""
    user_key = f"{email}_{notebook_uuid}"
    
    try:
        if not rate_limit_table:
            return {'requests_this_minute': 0, 'requests_this_hour': 0}
            
        response = rate_limit_table.get_item(Key={'user_id': user_key})
        user_data = response.get('Item', {})
        
        return {
            'requests_this_minute': user_data.get('requests_this_minute', 0),
            'requests_this_hour': user_data.get('requests_this_hour', 0),
            'limits': {
                'per_minute': 10,
                'per_hour': 50,
                'min_interval': 3
            }
        }
    except Exception as e:
        logger.warning(f"Failed to get rate limit status: {e}")
        return {'requests_this_minute': 0, 'requests_this_hour': 0}

class RateLimitException(Exception):
    pass

def load_vector_db(bucket: str, email: str, notebook_uuid: str) -> Dict:
    """Load vector database from S3"""
    try:
        key = f"notebooks/{email}/{notebook_uuid}/vectors/vector_db.json"
        response = s3_client.get_object(Bucket=bucket, Key=key)
        return json.loads(response['Body'].read().decode('utf-8'))
    except Exception as e:
        logger.error(f"Error loading vector DB: {e}")
        return {}

def search_relevant_chunks(vector_db: Dict, question: str) -> List[Dict]:
    """Search for relevant chunks using vector similarity with adaptive thresholds and matching preprocessing"""
    chunks = vector_db.get('chunks', [])
    if not chunks:
        return []
    
    try:
        # Generate embedding for the question using the same model and preprocessing as processing
        question_embedding = generate_question_embedding(question)
        
        # Debug: Log question for context
        logger.info(f"Question: '{question[:100]}{'...' if len(question) > 100 else ''}'")
        
        # Calculate similarity scores for all chunks
        all_chunks_with_scores = []
        
        for chunk in chunks:
            chunk_embedding = chunk.get('embedding')
            if not chunk_embedding:
                logger.warning(f"Chunk missing embedding, skipping: {chunk.get('id', 'unknown')}")
                continue
                
            # Verify embedding format
            if not isinstance(chunk_embedding, list) or len(chunk_embedding) != 1024:
                logger.warning(f"Invalid embedding format for chunk {chunk.get('id', 'unknown')}: length {len(chunk_embedding) if isinstance(chunk_embedding, list) else 'not list'}")
                continue
                
            # Calculate cosine similarity
            similarity_score = calculate_cosine_similarity(question_embedding, chunk_embedding)
            chunk_copy = chunk.copy()
            chunk_copy['similarity_score'] = similarity_score
            all_chunks_with_scores.append(chunk_copy)
        
        if not all_chunks_with_scores:
            logger.error("No valid chunks with embeddings found!")
            return []
        
        # Sort by similarity score (highest first)
        all_chunks_with_scores.sort(key=lambda x: x['similarity_score'], reverse=True)
        
        # Adaptive threshold based on the data
        max_score = all_chunks_with_scores[0]['similarity_score']
        avg_score = sum(chunk['similarity_score'] for chunk in all_chunks_with_scores) / len(all_chunks_with_scores)
        
        # Use dynamic threshold: either 50% of max score or 0.05, whichever is higher
        dynamic_threshold = max(max_score * 0.5, 0.05)
        
        logger.info(f"Similarity scores - Max: {max_score:.3f}, Avg: {avg_score:.3f}, Dynamic threshold: {dynamic_threshold:.3f}")
        
        # Apply dynamic threshold
        relevant_chunks = [chunk for chunk in all_chunks_with_scores if chunk['similarity_score'] >= dynamic_threshold]
        
        # Always ensure we have at least 3 chunks, but no more than 8
        if len(relevant_chunks) < 3:
            relevant_chunks = all_chunks_with_scores[:3]
            logger.info(f"Using top 3 chunks (below threshold)")
        elif len(relevant_chunks) > 8:
            relevant_chunks = relevant_chunks[:8]
            logger.info(f"Limited to top 8 chunks")
        else:
            logger.info(f"Using {len(relevant_chunks)} chunks above threshold")
        
        # Preview top chunks for debugging
        for i, chunk in enumerate(relevant_chunks[:3]):
            chunk_preview = chunk.get('text', '')[:100].replace('\n', ' ')
            metadata = chunk.get('metadata', {})
            source_name = metadata.get('filename', 'Unknown')
            logger.info(f"Top chunk {i+1} (score: {chunk['similarity_score']:.3f}) from {source_name}: {chunk_preview}...")
        
        logger.info(f"Found {len(relevant_chunks)} relevant chunks using vector similarity")
        return relevant_chunks
        
    except Exception as e:
        logger.error(f"Error in vector similarity search: {str(e)}")
        # Fallback to keyword search
        return search_relevant_chunks_fallback(vector_db, question)

def generate_question_embedding(question: str) -> List[float]:
    """Generate embedding for the question using Amazon Titan Text Embeddings V2 with matching preprocessing"""
    try:
        # Apply the SAME preprocessing as in the document processor
        # Clean text just like in create_chunks function
        cleaned_question = re.sub(r'\s+', ' ', question).strip()
        
        # Limit text length for embedding model (same as document processor)
        text_for_embedding = cleaned_question[:8000] if len(cleaned_question) > 8000 else cleaned_question
        
        request_body = {"inputText": text_for_embedding}
        
        response = bedrock_client.invoke_model(
            modelId='amazon.titan-embed-text-v2:0',
            body=json.dumps(request_body),
            contentType='application/json'
        )
        
        response_body = json.loads(response['body'].read())
        embedding = response_body['embedding']
        
        logger.info(f"Generated question embedding (length: {len(embedding)}) for cleaned text: '{text_for_embedding[:50]}{'...' if len(text_for_embedding) > 50 else ''}'")
        return embedding
        
    except Exception as e:
        logger.error(f"Error generating question embedding: {str(e)}")
        raise Exception(f"Failed to generate question embedding: {str(e)}")

def calculate_cosine_similarity(embedding1: List[float], embedding2: List[float]) -> float:
    """Calculate cosine similarity between two embeddings"""
    try:
        # Convert to numpy arrays for easier calculation
        vec1 = np.array(embedding1)
        vec2 = np.array(embedding2)
        
        # Calculate dot product
        dot_product = np.dot(vec1, vec2)
        
        # Calculate magnitudes
        magnitude1 = np.linalg.norm(vec1)
        magnitude2 = np.linalg.norm(vec2)
        
        # Avoid division by zero
        if magnitude1 == 0 or magnitude2 == 0:
            return 0.0
        
        # Calculate cosine similarity
        cosine_similarity = dot_product / (magnitude1 * magnitude2)
        
        return float(cosine_similarity)
        
    except Exception as e:
        logger.error(f"Error calculating cosine similarity: {str(e)}")
        return 0.0

def search_relevant_chunks_fallback(vector_db: Dict, question: str) -> List[Dict]:
    """Enhanced fallback keyword search with better scoring"""
    logger.warning("Using enhanced fallback keyword search")
    
    chunks = vector_db.get('chunks', [])
    if not chunks:
        return []
    
    # Clean and prepare question for keyword matching (same as document processor)
    question_clean = re.sub(r'\s+', ' ', question.lower()).strip()
    question_words = set(question_clean.split())
    
    # Remove very common words that don't add meaning
    stop_words = {'the', 'and', 'for', 'are', 'but', 'not', 'you', 'all', 'can', 'had', 'her', 'was', 'one', 'our', 'out', 'day', 'get', 'has', 'him', 'his', 'how', 'its', 'may', 'new', 'now', 'old', 'see', 'two', 'who', 'with', 'from', 'they', 'know', 'want', 'been', 'good', 'much', 'some', 'time', 'very', 'when', 'come', 'here', 'just', 'like', 'long', 'make', 'many', 'over', 'such', 'take', 'than', 'them', 'well', 'were'}
    meaningful_words = question_words - stop_words
    
    if not meaningful_words:
        meaningful_words = question_words  # Fallback to all words if no meaningful words found
    
    relevant_chunks = []
    
    for chunk in chunks:
        text_clean = re.sub(r'\s+', ' ', chunk.get('text', '').lower()).strip()
        text_words = set(text_clean.split())
        
        # Calculate multiple similarity metrics
        common_words = meaningful_words.intersection(text_words)
        
        if common_words:
            # Score based on multiple factors
            word_overlap_score = len(common_words) / len(meaningful_words)
            text_length_bonus = min(len(text_clean) / 1000, 0.1)  # Small bonus for longer texts
            
            # Look for exact phrase matches
            phrase_bonus = 0
            if len(question_clean) > 10:
                if question_clean in text_clean:
                    phrase_bonus = 0.5
            
            total_score = word_overlap_score + text_length_bonus + phrase_bonus
            
            chunk_copy = chunk.copy()
            chunk_copy['similarity_score'] = total_score
            relevant_chunks.append(chunk_copy)
    
    relevant_chunks.sort(key=lambda x: x['similarity_score'], reverse=True)
    
    # Log fallback search results
    if relevant_chunks:
        logger.info(f"Fallback search found {len(relevant_chunks)} chunks, top score: {relevant_chunks[0]['similarity_score']:.3f}")
    else:
        logger.warning("No chunks found even with fallback search")
        # Ultimate fallback: return first 3 chunks
        relevant_chunks = chunks[:3]
        for i, chunk in enumerate(relevant_chunks):
            chunk['similarity_score'] = 0.01  # Very low score to indicate poor match
    
    return relevant_chunks[:8]

