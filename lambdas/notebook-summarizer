def lambda_handler(event: Dict[str, Any], context: Any) -> Dict[str, Any]:
    """
    Summarizer using stored content from S3 with improved rate limiting and metadata updates
    """
    try:
        # Parse input
        bucket = event.get('bucket', 'smart-notebook-media')
        email = event.get('email')
        notebook_uuid = event.get('notebook_uuid')
        summary_types = event.get('summary_types', ['academic', 'casual', 'simple'])
        
        if not email or not notebook_uuid:
            raise ValueError("Missing email or notebook_uuid")
        
        logger.info(f"Generating summaries for notebook: {notebook_uuid}")
        
        # Load processed content or vector database
        content = load_notebook_content(bucket, email, notebook_uuid)
        
        if not content:
            return {
                'statusCode': 400,
                'body': {'error': 'No content found. Please process your notebook files first.'}
            }
        
        # Generate summaries with proper rate limiting
        summaries = {}
        successful_summaries = []
        failed_summaries = []
        
        for i, summary_type in enumerate(summary_types):
            try:
                logger.info(f"Generating {summary_type} summary ({i+1}/{len(summary_types)})...")
                
                # Progressive delay to avoid throttling
                if i > 0:
                    delay = 10 + (i * 5)  # 10, 15, 20 seconds between requests
                    logger.info(f"Waiting {delay} seconds before next request...")
                    time.sleep(delay)
                
                summary = generate_summary_with_retry(content, summary_type)
                summaries[summary_type] = summary
                successful_summaries.append(summary_type)
                
                # Save to S3
                summary_key = f"notebooks/{email}/{notebook_uuid}/summaries/{summary_type}_summary.txt"
                save_summary_to_s3(bucket, summary_key, summary)
                
                logger.info(f"Successfully generated {summary_type} summary")
                
            except Exception as e:
                error_msg = f"Error: {str(e)}"
                logger.error(f"Error generating {summary_type} summary: {str(e)}")
                summaries[summary_type] = error_msg
                failed_summaries.append(summary_type)
        
        # Create combined report only if we have successful summaries
        if successful_summaries:
            try:
                combined_summary = create_combined_report(summaries, notebook_uuid, email)
                combined_key = f"notebooks/{email}/{notebook_uuid}/summaries/combined_summary.txt"
                save_summary_to_s3(bucket, combined_key, combined_summary)
            except Exception as e:
                logger.error(f"Error creating combined report: {str(e)}")
        
        # Create metadata
        metadata = {
            'notebook_uuid': notebook_uuid,
            'user_email': email,
            'generated_at': datetime.now().isoformat(),
            'summary_types_requested': summary_types,
            'summary_types_successful': successful_summaries,
            'summary_types_failed': failed_summaries,
            'content_length': len(content),
            'method': 'S3-based RAG with rate limiting'
        }
        
        metadata_key = f"notebooks/{email}/{notebook_uuid}/summaries/metadata.json"
        save_metadata_to_s3(bucket, metadata_key, metadata)
        
        # UPDATE NOTEBOOK METADATA IN DYNAMODB AND S3
        try:
            update_notebook_metadata(bucket, email, notebook_uuid, successful_summaries, failed_summaries)
        except Exception as e:
            logger.error(f"Failed to update notebook metadata: {str(e)}")
            # Don't fail the whole operation if metadata update fails
        
        return {
            'statusCode': 200,
            'body': {
                'message': f'Summary generation completed. {len(successful_summaries)} successful, {len(failed_summaries)} failed.',
                'notebook_uuid': notebook_uuid,
                'summaries_generated': successful_summaries,
                'summaries_failed': failed_summaries,
                'content_length': len(content),
                'summary_locations': {
                    summary_type: f"s3://{bucket}/notebooks/{email}/{notebook_uuid}/summaries/{summary_type}_summary.txt"
                    for summary_type in successful_summaries
                },
                'errors': [f"{summary_type}: {summaries[summary_type]}" for summary_type in failed_summaries],
                'retry_suggestion': "If some summaries failed due to throttling, try running again in a few minutes." if failed_summaries else None,
                'metadata_updated': True
            }
        }
        
    except Exception as e:
        logger.error(f"Error: {str(e)}")
        return {
            'statusCode': 500,
            'body': {'error': str(e)}
        }

def update_notebook_metadata(bucket: str, email: str, notebook_uuid: str, 
                           successful_summaries: List[str], failed_summaries: List[str]):
    """
    Update notebook metadata in both DynamoDB and S3 with summary information
    """
    timestamp = datetime.now().isoformat()
    
    # Prepare summary metadata
    summary_metadata = {
        'summary_types_available': successful_summaries,
        'summary_types_failed': failed_summaries,
        'last_summarization_date': timestamp,
        'summarization_status': 'completed' if successful_summaries and not failed_summaries else 'partial' if successful_summaries else 'failed',
        'total_summaries_available': len(successful_summaries)
    }
    
    # 1. UPDATE DYNAMODB METADATA
    if notebooks_table:
        try:
            # Use your existing key structure
            pk = f"USER#{email}"
            sk = f"NOTEBOOK#{notebook_uuid}"
            
            logger.info(f"Attempting to update DynamoDB with PK: {pk}, SK: {sk}")
            
            # First, let's try to get the item to see if it exists
            try:
                get_response = notebooks_table.get_item(
                    Key={
                        'PK': pk,
                        'SK': sk
                    }
                )
                
                if 'Item' not in get_response:
                    logger.warning(f"Item not found in DynamoDB with PK: {pk}, SK: {sk}")
                    logger.warning("Skipping DynamoDB update - item doesn't exist")
                    # Skip DynamoDB update if item doesn't exist
                    return
                else:
                    logger.info("Found existing item in DynamoDB, proceeding with update")
                    
            except Exception as get_error:
                logger.error(f"Error checking if item exists: {str(get_error)}")
                # If we can't check, skip the DynamoDB update
                return
            
            # Prepare update expression for your schema
            update_expression = "SET "
            update_parts = []
            expression_values = {}
            
            # Add summary types as DynamoDB list format
            if successful_summaries:
                update_parts.append("summary_types_available = :summary_types")
                expression_values[':summary_types'] = successful_summaries
                
            if failed_summaries:
                update_parts.append("summary_types_failed = :failed_types") 
                expression_values[':failed_types'] = failed_summaries
            else:
                update_parts.append("summary_types_failed = :failed_types")
                expression_values[':failed_types'] = []
            
            update_parts.extend([
                "last_summarization_date = :timestamp",
                "summarization_status = :status", 
                "total_summaries_available = :total_summaries",
                "has_summaries = :has_summaries",
                "updatedAt = :updated_at"
            ])
            
            expression_values.update({
                ':timestamp': timestamp,
                ':status': summary_metadata['summarization_status'],
                ':total_summaries': len(successful_summaries),
                ':has_summaries': len(successful_summaries) > 0,
                ':updated_at': timestamp
            })
            
            # Add summary locations
            if successful_summaries:
                update_parts.append("summary_locations = :locations")
                expression_values[':locations'] = {
                    summary_type: f"s3://{bucket}/notebooks/{email}/{notebook_uuid}/summaries/{summary_type}_summary.txt"
                    for summary_type in successful_summaries
                }
            
            update_expression += ", ".join(update_parts)
            
            logger.info(f"Update expression: {update_expression}")
            logger.info(f"Expression values keys: {list(expression_values.keys())}")
            
            # Update DynamoDB using your key structure
            update_response = notebooks_table.update_item(
                Key={
                    'PK': pk,
                    'SK': sk
                },
                UpdateExpression=update_expression,
                ExpressionAttributeValues=expression_values,
                ReturnValues="UPDATED_NEW"
            )
            
            logger.info(f"Successfully updated DynamoDB metadata for notebook {notebook_uuid}")
            logger.info(f"Updated attributes: {list(update_response.get('Attributes', {}).keys())}")
            
        except Exception as e:
            logger.error(f"Failed to update DynamoDB metadata: {str(e)}")
            logger.error(f"Error type: {type(e).__name__}")
            
            # Log more details for debugging
            if "ResourceNotFoundException" in str(e):
                logger.error("Table or item not found. Check:")
                logger.error(f"1. Table name: 'notebooks'")
                logger.error(f"2. Keys: PK='{pk}', SK='{sk}'")
                logger.error("3. Ensure the notebook record exists before running summarization")
            
            # Continue to S3 update even if DynamoDB fails
    else:
        logger.warning("DynamoDB table connection not available, skipping DynamoDB update")
    
    # 2. UPDATE S3 NOTEBOOK METADATA (this part works fine)
    try:
        # Load existing notebook metadata from S3
        metadata_key = f"notebooks/{email}/{notebook_uuid}/metadata.json"
        
        try:
            # Try to load existing metadata
            response = s3_client.get_object(Bucket=bucket, Key=metadata_key)
            existing_metadata = json.loads(response['Body'].read().decode('utf-8'))
        except s3_client.exceptions.NoSuchKey:
            # Create new metadata if doesn't exist
            existing_metadata = {
                'notebook_uuid': notebook_uuid,
                'user_email': email,
                'created_at': timestamp,
                'processing_history': []
            }
        except Exception as e:
            logger.warning(f"Error loading existing metadata, creating new: {str(e)}")
            existing_metadata = {
                'notebook_uuid': notebook_uuid,
                'user_email': email,
                'created_at': timestamp,
                'processing_history': []
            }
        
        # Update metadata with summary information
        existing_metadata.update({
            'summary_types_available': successful_summaries,
            'summary_types_failed': failed_summaries,
            'last_summarization_date': timestamp,
            'summarization_status': summary_metadata['summarization_status'],
            'total_summaries_available': len(successful_summaries),
            'has_summaries': len(successful_summaries) > 0,
            'last_updated': timestamp
        })
        
        # Add summary locations
        if successful_summaries:
            existing_metadata['summary_locations'] = {
                summary_type: f"s3://{bucket}/notebooks/{email}/{notebook_uuid}/summaries/{summary_type}_summary.txt"
                for summary_type in successful_summaries
            }
        
        # Add to processing history
        if 'processing_history' not in existing_metadata:
            existing_metadata['processing_history'] = []
        
        processing_event = {
            'type': 'summarization',
            'timestamp': timestamp,
            'status': summary_metadata['summarization_status'],
            'summary_types_generated': successful_summaries,
            'summary_types_failed': failed_summaries,
            'total_summaries': len(successful_summaries)
        }
        
        existing_metadata['processing_history'].append(processing_event)
        
        # Keep only last 10 processing events
        existing_metadata['processing_history'] = existing_metadata['processing_history'][-10:]
        
        # Save updated metadata to S3
        s3_client.put_object(
            Bucket=bucket,
            Key=metadata_key,
            Body=json.dumps(existing_metadata, indent=2, default=str).encode('utf-8'),
            ContentType='application/json',
            Metadata={
                'notebook-uuid': notebook_uuid,
                'user-email': email,
                'last-updated': timestamp,
                'has-summaries': str(len(successful_summaries) > 0),
                'summary-types': ','.join(successful_summaries) if successful_summaries else 'none',
                'summarization-status': summary_metadata['summarization_status']
            }
        )
        
        logger.info(f"Successfully updated S3 metadata for notebook {notebook_uuid}")
        
    except Exception as e:
        logger.error(f"Failed to update S3 metadata: {str(e)}")

