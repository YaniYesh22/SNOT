def load_notebook_content(bucket: str, email: str, notebook_uuid: str) -> str:
    """Load content from processed files or vector database"""
    try:
        # Try to load from vector database first (more organized)
        try:
            vector_db_key = f"notebooks/{email}/{notebook_uuid}/vectors/vector_db.json"
            response = s3_client.get_object(Bucket=bucket, Key=vector_db_key)
            vector_db = json.loads(response['Body'].read().decode('utf-8'))
            
            # Extract content from chunks, organized by file
            files_content = {}
            for chunk in vector_db.get('chunks', []):
                metadata = chunk.get('metadata', {})
                filename = metadata.get('filename', 'Unknown')
                content_type = metadata.get('content_type', 'files')
                
                # Skip error chunks
                if chunk['text'].startswith('[Error') or chunk['text'].startswith('[Unsupported'):
                    continue
                
                if filename not in files_content:
                    files_content[filename] = {
                        'type': content_type,
                        'chunks': []
                    }
                
                files_content[filename]['chunks'].append(chunk['text'])
            
            # Format content
            formatted_content = []
            for filename, file_data in files_content.items():
                if not file_data['chunks']:  # Skip files with no valid content
                    continue
                    
                content_type_label = "VIDEO TRANSCRIPTION" if file_data['type'] == 'transcribe' else "DOCUMENT"
                formatted_content.append(f"\n=== {content_type_label}: {filename} ===\n")
                formatted_content.append('\n\n'.join(file_data['chunks']))
                formatted_content.append('\n' + '='*60 + '\n')
            
            content = '\n'.join(formatted_content)
            logger.info(f"Loaded content from vector database: {len(content)} characters from {len(files_content)} files")
            return content
            
        except Exception as vector_error:
            logger.info(f"Vector database not found, trying processed files: {str(vector_error)}")
            
            # Fallback to processed files
            prefix = f"notebooks/{email}/{notebook_uuid}/processed/"
            response = s3_client.list_objects_v2(Bucket=bucket, Prefix=prefix)
            
            if 'Contents' not in response:
                return ""
            
            content_parts = []
            for obj in response['Contents']:
                if obj['Key'].endswith('.txt'):
                    try:
                        file_response = s3_client.get_object(Bucket=bucket, Key=obj['Key'])
                        content = file_response['Body'].read().decode('utf-8')
                        
                        filename = obj['Key'].split('/')[-1]
                        content_parts.append(f"\n--- {filename} ---\n{content}\n")
                        
                    except Exception as e:
                        logger.warning(f"Error reading {obj['Key']}: {str(e)}")
                        continue
            
            content = '\n'.join(content_parts)
            logger.info(f"Loaded content from processed files: {len(content)} characters")
            return content
            
    except Exception as e:
        logger.error(f"Error loading notebook content: {str(e)}")
        return ""

def create_combined_report(summaries: Dict[str, str], notebook_uuid: str, email: str) -> str:
    """Create combined report with all summaries"""
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S UTC")
    
    successful_summaries = {k: v for k, v in summaries.items() if not v.startswith('Error')}
    failed_summaries = {k: v for k, v in summaries.items() if v.startswith('Error')}
    
    report_parts = [
        f"# Comprehensive Summary Report",
        f"**Notebook ID:** {notebook_uuid}",
        f"**User:** {email}",
        f"**Generated:** {timestamp}",
        f"**Method:** S3-based RAG with Rate Limiting",
        f"**Successful Summaries:** {', '.join(successful_summaries.keys()) if successful_summaries else 'None'}",
        f"**Failed Summaries:** {', '.join(failed_summaries.keys()) if failed_summaries else 'None'}",
        "\n" + "=" * 60 + "\n"
    ]
    
    # Add each successful summary
    for summary_type, content in successful_summaries.items():
        report_parts.extend([
            f"## {summary_type.title()} Summary",
            "",
            content,
            "\n" + "-" * 40 + "\n"
        ])
    
    # Add error section if there were failures
    if failed_summaries:
        report_parts.extend([
            "## Generation Errors",
            "",
            "The following summaries could not be generated:",
            ""
        ])
        for summary_type, error in failed_summaries.items():
            report_parts.append(f"- **{summary_type.title()}:** {error}")
        
        report_parts.append("\n" + "-" * 40 + "\n")
    
    return "\n".join(report_parts)

def save_summary_to_s3(bucket: str, key: str, summary: str):
    """Save summary to S3 with metadata"""
    timestamp = datetime.now().isoformat()
    summary_type = key.split('/')[-1].replace('_summary.txt', '')
    
    s3_client.put_object(
        Bucket=bucket,
        Key=key,
        Body=summary.encode('utf-8'),
        ContentType='text/plain',
        Metadata={
            'summary-type': summary_type,
            'created-at': timestamp,
            'content-type': 'summary',
            'word-count': str(len(summary.split())),
            'character-count': str(len(summary))
        }
    )

def save_metadata_to_s3(bucket: str, key: str, metadata: Dict):
    """Save metadata to S3"""
    s3_client.put_object(
        Bucket=bucket,
        Key=key,
        Body=json.dumps(metadata, indent=2, default=str).encode('utf-8'),
        ContentType='application/json',
        Metadata={
            'content-type': 'metadata',
            'created-at': datetime.now().isoformat()
        }
    )
